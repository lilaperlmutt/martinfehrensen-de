{{- $allPages := slice -}}
{{- range .Site.Sections -}}
  {{- range .Pages -}}
    {{- if not .Params.unlisted -}}
      {{- $allPages = $allPages | append . -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $allPages = sort $allPages "Date" "desc" -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0"
  xmlns:atom="http://www.w3.org/2005/Atom"
  xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Site.BaseURL }}</link>
    <description>{{ .Site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ .Site.Language.Lang }}</language>
    <atom:link href="{{ .Site.BaseURL }}index.xml" rel="self" type="application/rss+xml" />
    {{ range $allPages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 +0000" }}</pubDate>
      <guid>{{ .Permalink }}</guid>

      {{/* Bild-Ressource ermitteln */}}
      {{ $imgURL := "" }}
      {{ $imgType := "image/jpeg" }}
      {{ $imgLength := 0 }}

      {{ if ne .Params.rss_image false }}
        {{/* 1. Versuch: Aus Page Resources (Page Bundle) holen und als JPG resizen */}}
        {{ with .Resources.GetMatch (.Params.image) }}
          {{ $resized := .Resize "800x jpg q80" }}
          {{ $imgURL = $resized.Permalink }}
          {{ $imgLength = len $resized.Content }}
        {{ else }}
          {{/* 2. Versuch: Falls als globaler Pfad in static/ angegeben */}}
          {{ if .Params.image }}
            {{ $imgURL = .Params.image | absURL }}
          {{ end }}
        {{ end }}
      {{ end }}

      {{/* RSS Enclosure & Media Content Tags */}}
      {{ if $imgURL }}
        <enclosure url="{{ $imgURL }}" length="{{ $imgLength }}" type="{{ $imgType }}" />
        <media:content url="{{ $imgURL }}" medium="image" />
      {{ end }}

      <description><![CDATA[
        {{- if $imgURL -}}
          <p><img src="{{ $imgURL }}" alt="{{ .Title }}" /></p>
        {{- end -}}
        {{ .Content }}
      ]]></description>
    </item>
    {{ end }}
  </channel>
</rss>